FROM golang:1.24-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/storagenode ./cmd/storagenode

FROM alpine:3.21
WORKDIR /app
COPY --from=builder /bin/storagenode /bin/storagenode
EXPOSE 8081
ENTRYPOINT ["/bin/storagenode"]
